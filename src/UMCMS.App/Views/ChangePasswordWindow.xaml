<Window x:Class="UMCMS.App.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password" Height="320" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="White">
    <Border Padding="22">
        <StackPanel>
            <TextBlock Text="Change Password" Style="{StaticResource H1}" FontSize="18" Margin="0,0,0,14"/>
            <TextBlock Text="Current password" Style="{StaticResource SubtleText}"/>
            <PasswordBox x:Name="Current" Height="36" Margin="0,2,0,10"/>
            <TextBlock Text="New password" Style="{StaticResource SubtleText}"/>
            <PasswordBox x:Name="New1" Height="36" Margin="0,2,0,10"/>
            <TextBlock Text="Confirm new password" Style="{StaticResource SubtleText}"/>
            <PasswordBox x:Name="New2" Height="36" Margin="0,2,0,10"/>
            <TextBlock x:Name="TxtError" Foreground="#8A0007" FontSize="12" Visibility="Collapsed" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                <Button Content="Update" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Update_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
