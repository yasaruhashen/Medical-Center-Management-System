<Window x:Class="UMCMS.App.Views.EmergencyAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emergency Contact" Height="470" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="White">
    <Border Padding="22">
        <StackPanel>
            <TextBlock Text="🚨 Emergency Contact Lookup" Style="{StaticResource H1}" FontSize="18" Foreground="#8A0007"/>
            <TextBlock x:Name="TxtPatient" Style="{StaticResource SubtleText}" Margin="0,2,0,14"/>

            <!-- Patient mobile -->
            <Border Background="#FBE9E9" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Patient mobile" Style="{StaticResource SubtleText}"/>
                    <TextBlock x:Name="TxtPatientPhone" FontSize="24" FontWeight="Bold" Foreground="#4E0205"/>
                </StackPanel>
            </Border>

            <!-- Emergency contact mobile -->
            <Border Background="#FBF7F2" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="TxtContactLabel" Text="Emergency contact (parent/guardian)" Style="{StaticResource SubtleText}"/>
                    <TextBlock x:Name="TxtContactPhone" FontSize="24" FontWeight="Bold" Foreground="#4E0205"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Reason / note (recorded in the audit log)" Style="{StaticResource SubtleText}"/>
            <TextBox x:Name="FNote" Style="{StaticResource FormInput}" Height="64" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,2,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
                <Button Content="✓ Log Emergency Contact" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Log_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
