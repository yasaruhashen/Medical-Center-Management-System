<UserControl x:Class="UMCMS.App.Views.PharmacistQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="640" d:DesignWidth="1000">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource SecondaryButton}" Click="BtnRefresh_Click"/>
                <StackPanel>
                    <TextBlock Text="Dispensary — Pending Prescriptions" Style="{StaticResource H2}"/>
                    <TextBlock Text="Prescriptions sent by doctors, awaiting dispensing." Style="{StaticResource SubtleText}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="QueueGrid" AutoGenerateColumns="True" AutoGeneratingColumn="HideId" SelectionChanged="QueueGrid_SelectionChanged"/>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="TxtDetailTitle" Text="Select a prescription" Style="{StaticResource H2}" Margin="14,12,0,8"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="14">
                        <Button x:Name="BtnPrint" Content="🖨 Print Prescription Slip" Style="{StaticResource SecondaryButton}"
                                Click="BtnPrint_Click" IsEnabled="False" Margin="0,0,0,8"/>
                        <Button x:Name="BtnLabels" Content="🏷 Print Dispensing Labels" Style="{StaticResource SecondaryButton}"
                                Click="BtnLabels_Click" IsEnabled="False" Margin="0,0,0,8"/>
                        <Button x:Name="BtnDispense" Content="✓ Dispense All &amp; Complete"
                                Style="{StaticResource PrimaryButton}" Click="BtnDispense_Click" IsEnabled="False"/>
                    </StackPanel>
                    <DataGrid x:Name="DetailGrid" AutoGenerateColumns="True"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
