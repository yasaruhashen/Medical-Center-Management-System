<UserControl x:Class="Project_.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <ScrollViewer Padding="25" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="MainContainer" Opacity="0">
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,0" To="0,0,0,0" Duration="0:0:0.5">
                                <ThicknessAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                            </ThicknessAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="User Management" FontWeight="Bold" FontSize="24" Foreground="#1F2937"/>
                    <TextBlock Text="Manage system users — add, edit, or remove accounts" FontSize="14" Foreground="#6B7280"/>
                </StackPanel>
                <Button x:Name="BtnAddUser" Grid.Column="1" Content="+ Add User" Background="#8A0007" Foreground="White" FontWeight="SemiBold"
                        Padding="15,10" BorderThickness="0" Click="BtnAddUser_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Search -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtSearch" Text="Search users..." Foreground="#9CA3AF" BorderThickness="0" Background="Transparent" Width="400" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus"/>
                </StackPanel>
            </Border>

            <!-- Table -->
            <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Border Background="#4E0205" CornerRadius="12,12,0,0" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Name" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Username" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Role" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Email" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Actions" Foreground="White" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                <ItemsControl x:Name="UsersList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="15,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{Binding RoleColor}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding FullName}" Foreground="#1F2937" VerticalAlignment="Center"/>
                                        <Border Visibility="{Binding IsCurrentUser}" Background="#F7AA37" CornerRadius="4" Padding="4,2" Margin="5,0,0,0">
                                            <TextBlock Text="You" Foreground="Black" FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Column="1" Text="{Binding Username}" Foreground="#4B5563" VerticalAlignment="Center"/>
                                    
                                    <Border Grid.Column="2" Background="{Binding RoleBgColor}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Role}" Foreground="{Binding RoleColor}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    
                                    <TextBlock Grid.Column="3" Text="{Binding Email}" Foreground="#6B7280" VerticalAlignment="Center"/>
                                    
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="✏️" Tag="{Binding Id}" Click="BtnEditUser_Click" Background="Transparent" BorderThickness="0" Margin="0,0,5,0" Cursor="Hand"/>
                                        <Button Content="🗑️" Tag="{Binding Id}" Click="BtnDeleteUser_Click" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
