<UserControl x:Class="Project_.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <Grid>
        <ScrollViewer Padding="25" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MainContainer" Opacity="0">
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,0" To="0,0,0,0" Duration="0:0:0.5">
                                    <ThicknessAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                </ThicknessAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </StackPanel.Triggers>
                
                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Inventory Management" FontWeight="Bold" FontSize="24" Foreground="#1F2937"/>
                        <TextBlock Text="Manage medicines and medical supplies" FontSize="14" Foreground="#6B7280"/>
                    </StackPanel>
                    <Button x:Name="BtnAddItem" Grid.Column="1" Content="+ Add Item" Background="#8A0007" Foreground="White" FontWeight="SemiBold"
                            Padding="15,10" BorderThickness="0" Click="BtnAddItem_Click" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- Summary Blocks -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="15">
                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtTotalItems" Text="0" FontSize="26" FontWeight="Bold" Foreground="#8A0007" HorizontalAlignment="Center"/>
                            <TextBlock Text="Total Items" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="2" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="15">
                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtInStock" Text="0" FontSize="26" FontWeight="Bold" Foreground="#16a34a" HorizontalAlignment="Center"/>
                            <TextBlock Text="In Stock" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="15">
                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtLowStock" Text="0" FontSize="26" FontWeight="Bold" Foreground="#d97706" HorizontalAlignment="Center"/>
                            <TextBlock Text="Low Stock" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="15">
                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtOutStock" Text="0" FontSize="26" FontWeight="Bold" Foreground="#991b1b" HorizontalAlignment="Center"/>
                            <TextBlock Text="Out of Stock" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Search and Filter -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtSearch" Text="Search items..." Foreground="#9CA3AF" BorderThickness="0" Background="Transparent" Width="400" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="5,0">
                        <ComboBox x:Name="CmbCategory" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" VerticalContentAlignment="Center" Height="38" SelectionChanged="CmbCategory_SelectionChanged">
                            <ComboBoxItem Content="All Categories" IsSelected="True"/>
                            <ComboBoxItem Content="Pills"/>
                            <ComboBoxItem Content="Capsules"/>
                            <ComboBoxItem Content="Syrups"/>
                            <ComboBoxItem Content="Equipment"/>
                        </ComboBox>
                    </Border>
                </Grid>

                <!-- Table -->
                <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Table Header -->
                        <Border Background="#4E0205" CornerRadius="12,12,0,0" Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Item" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="Category" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="Quantity" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="Unit" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="Expiry" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="5" Text="Min Stock" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="6" Text="Status" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="7" Text="Actions" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="InventoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="15,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Item -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="📦" Foreground="#8A0007" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="#1F2937" FontWeight="Medium" VerticalAlignment="Center" FontSize="13"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Supplier}" Foreground="#9CA3AF" FontSize="11" Margin="25,0,0,0"/>
                                            </StackPanel>
                                            
                                            <!-- Category -->
                                            <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" Foreground="#4B5563" FontSize="11"/>
                                            </Border>
                                            
                                            <!-- Quantity -->
                                            <TextBlock Grid.Column="2" Text="{Binding Quantity}" Foreground="{Binding QtyColor}" FontWeight="Bold" VerticalAlignment="Center" FontSize="13"/>
                                            
                                            <!-- Unit -->
                                            <TextBlock Grid.Column="3" Text="{Binding Unit}" Foreground="#4B5563" VerticalAlignment="Center" FontSize="13"/>
                                            
                                            <!-- Expiry -->
                                            <TextBlock Grid.Column="4" Text="{Binding ExpiryDate}" Foreground="#4B5563" VerticalAlignment="Center" FontSize="13"/>
                                            
                                            <!-- Min Stock -->
                                            <TextBlock Grid.Column="5" Text="{Binding MinStock}" Foreground="#4B5563" VerticalAlignment="Center" FontSize="13"/>
                                            
                                            <!-- Status -->
                                            <Border Grid.Column="6" Background="{Binding StatusBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                            
                                            <!-- Actions -->
                                            <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="✏️" Tag="{Binding Id}" Click="BtnEditItem_Click" Background="Transparent" BorderThickness="0" Margin="0,0,5,0" Cursor="Hand"/>
                                                <Button Content="🗑️" Tag="{Binding Id}" Click="BtnDeleteItem_Click" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Add/Edit overlay -->
        <Border x:Name="OverlayItem" Background="#88000000" Visibility="Collapsed" Panel.ZIndex="10">
            <Border Background="White" CornerRadius="16" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="20,15">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8A0007" Offset="0"/>
                                <GradientStop Color="#4E0205" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <TextBlock x:Name="TxtItemTitle" Text="Add Inventory Item" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Foreground="#FECACA" BorderThickness="0" FontSize="14" Click="CloseOverlays" Cursor="Hand"/>
                        </Grid>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="600" Padding="25">
                        <StackPanel>
                            <!-- Fields layout mimicking the React grid layout -->
                            <TextBlock Text="Item Name *" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                            <TextBox x:Name="IName" Padding="8,6" Margin="0,0,0,15" BorderBrush="#E5E7EB" BorderThickness="1">
                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                            </TextBox>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Category *" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                                    <TextBox x:Name="ICategory" Padding="8,6" BorderBrush="#E5E7EB" BorderThickness="1">
                                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Unit *" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                                    <TextBox x:Name="IUnit" Padding="8,6" BorderBrush="#E5E7EB" BorderThickness="1">
                                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                                    </TextBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Quantity" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                                    <TextBox x:Name="IQuantity" Padding="8,6" BorderBrush="#E5E7EB" BorderThickness="1">
                                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Min Stock" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                                    <TextBox x:Name="IMinStock" Padding="8,6" BorderBrush="#E5E7EB" BorderThickness="1">
                                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                                    </TextBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Expiry Date" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                                    <DatePicker x:Name="IExpiry" Height="32"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Supplier" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                                    <TextBox x:Name="ISupplier" Padding="8,6" BorderBrush="#E5E7EB" BorderThickness="1">
                                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                                    </TextBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="10,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Button Grid.Column="0" Content="Cancel" Padding="0,10" Background="White" Foreground="#4B5563" BorderBrush="#E5E7EB" BorderThickness="1" Click="CloseOverlays" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>
                                
                                <Button Grid.Column="2" Padding="0,10" Background="#8A0007" Foreground="White" BorderThickness="0" Click="BtnSaveItem_Click" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✓" Margin="0,0,5,0" FontWeight="Bold"/>
                                            <TextBlock Text="Save Item" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <!-- Delete overlay -->
        <Border x:Name="OverlayDelete" Background="#88000000" Visibility="Collapsed" Panel.ZIndex="10">
            <Border Background="White" CornerRadius="16" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="25">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <Border Width="48" Height="48" CornerRadius="24" Background="#FFF0F0" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <TextBlock Text="🗑️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8A0007"/>
                    </Border>
                    <TextBlock Text="Remove Item?" FontWeight="Bold" FontSize="18" Foreground="#1F2937" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="This will permanently delete the inventory item." FontSize="14" Foreground="#6B7280" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" Content="Cancel" Padding="0,10" Background="White" Foreground="#4B5563" BorderBrush="#E5E7EB" BorderThickness="1" Click="CloseOverlays" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        
                        <Button Grid.Column="2" Content="Remove" Padding="0,10" Background="#8A0007" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="BtnConfirmDelete_Click" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
