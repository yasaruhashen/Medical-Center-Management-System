<UserControl x:Class="Project_.Views.StaffDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <Grid>
        <ScrollViewer Padding="25" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MainContainer" Opacity="0">
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,0" To="0,0,0,0" Duration="0:0:0.5">
                                    <ThicknessAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                </ThicknessAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </StackPanel.Triggers>
                
                <!-- Header -->
                <StackPanel Margin="0,0,0,25">
                    <TextBlock Text="Staff Dashboard" FontWeight="Bold" FontSize="24" Foreground="#1F2937"/>
                    <TextBlock x:Name="TxtDate" Text="Today: " FontSize="14" Foreground="#6B7280"/>
                </StackPanel>

                <!-- 4 Summary Stats -->
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Patients -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="15">
                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="45" Height="45" CornerRadius="12" Background="#FFF0F0" Margin="0,0,15,0">
                                <TextBlock Text="👥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8A0007"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Total Patients" FontSize="12" Foreground="#6B7280"/>
                                <TextBlock x:Name="TxtTotalPatients" Text="0" FontSize="22" FontWeight="Bold" Foreground="#8A0007"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Today's Appointments -->
                    <Border Grid.Column="2" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="15">
                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="45" Height="45" CornerRadius="12" Background="#FDF0F0" Margin="0,0,15,0">
                                <TextBlock Text="📅" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#4E0205"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Today's Appts" FontSize="12" Foreground="#6B7280"/>
                                <TextBlock x:Name="TxtTodayAppointments" Text="0" FontSize="22" FontWeight="Bold" Foreground="#4E0205"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Pending Prescriptions -->
                    <Border Grid.Column="4" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="15">
                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="45" Height="45" CornerRadius="12" Background="#FFFBEB" Margin="0,0,15,0">
                                <TextBlock Text="💊" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B45309"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Pending Rx" FontSize="12" Foreground="#6B7280"/>
                                <TextBlock x:Name="TxtPendingRx" Text="0" FontSize="22" FontWeight="Bold" Foreground="#B45309"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Low Stock Alerts -->
                    <Border Grid.Column="6" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="15">
                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="45" Height="45" CornerRadius="12" Background="#FFFBEB" Margin="0,0,15,0">
                                <TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D97706"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Low Stock" FontSize="12" Foreground="#6B7280"/>
                                <TextBlock x:Name="TxtLowStock" Text="0" FontSize="22" FontWeight="Bold" Foreground="#D97706"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Today's Appointments -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="🕒" Foreground="#8A0007" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Today's Appointments" FontWeight="SemiBold" FontSize="16" Foreground="#374151" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl x:Name="AppointmentsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PatientName}" FontWeight="Medium" Foreground="#1F2937" FontSize="14"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding DoctorName}" Foreground="#6B7280" FontSize="12"/>
                                                        <TextBlock Text=" • " Foreground="#6B7280" FontSize="12"/>
                                                        <TextBlock Text="{Binding Time}" Foreground="#6B7280" FontSize="12"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{Binding StatusBg}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" FontSize="11"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Inventory Overview (Pie Chart) -->
                    <Border Grid.Column="2" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="📦" Foreground="#8A0007" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Inventory Overview" FontWeight="SemiBold" FontSize="16" Foreground="#374151" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid Height="160">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                
                                <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="130" Height="130">
                                    <Ellipse Fill="#8A0007" Width="130" Height="130"/>
                                    <Path Data="M 65,65 L 130,65 A 65,65 0 0,1 65,130 Z" Fill="#F7AA37"/>
                                    <Path Data="M 65,65 L 65,130 A 65,65 0 0,1 0,65 Z" Fill="#4E0205"/>
                                    <Ellipse Fill="White" Width="70" Height="70" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#8A0007" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Pills" Foreground="#4B5563" FontSize="12" Width="60"/>
                                        <TextBlock Text="450" Foreground="#8A0007" FontWeight="Bold" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#4E0205" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Capsules" Foreground="#4B5563" FontSize="12" Width="60"/>
                                        <TextBlock Text="120" Foreground="#4E0205" FontWeight="Bold" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#F7AA37" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Syrups" Foreground="#4B5563" FontSize="12" Width="60"/>
                                        <TextBlock Text="85" Foreground="#F7AA37" FontWeight="Bold" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Pending Prescriptions Alert -->
                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,25">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="⚠️" FontSize="20" Foreground="#D97706" Margin="0,0,15,0"/>
                        <StackPanel>
                            <TextBlock Text="Pending Prescriptions (5)" FontWeight="SemiBold" Foreground="#92400E" FontSize="14" Margin="0,0,0,2"/>
                            <TextBlock Text="There are 5 prescription(s) waiting to be processed. Go to Prescription Processing to handle them." Foreground="#B45309" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
