<UserControl x:Class="Project_.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Project_.Views"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════
             COLOR PALETTE
             Primary:   #8A0007  (Deep Red)
             Secondary: #4E0205  (Dark Maroon)
             Accent:    #F7AA37  (Gold/Orange)
             Base:      #000000  (Black)
             Nav BG:    #FFFFFF  (White)
        ══════════════════════════════════════════════ -->

        <Color x:Key="DeepRedColor">#8A0007</Color>
        <Color x:Key="DarkMaroonColor">#4E0205</Color>
        <Color x:Key="GoldColor">#F7AA37</Color>

        <SolidColorBrush x:Key="DeepRedBrush"     Color="#8A0007"/>
        <SolidColorBrush x:Key="DarkMaroonBrush"  Color="#4E0205"/>
        <SolidColorBrush x:Key="GoldBrush"        Color="#F7AA37"/>
        <SolidColorBrush x:Key="BlackBrush"       Color="#000000"/>
        <SolidColorBrush x:Key="WhiteBrush"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LightGrayBrush"   Color="#F5F5F5"/>
        <SolidColorBrush x:Key="MidGrayBrush"     Color="#CCCCCC"/>
        <SolidColorBrush x:Key="TextGrayBrush"    Color="#555555"/>

        <!-- Linear gradient for the right panel background -->
        <LinearGradientBrush x:Key="RightPanelGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8A0007" Offset="0.0"/>
            <GradientStop Color="#4E0205" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Subtle gradient for login card shadow effect -->
        <LinearGradientBrush x:Key="CardShadowBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#22000000" Offset="0.0"/>
            <GradientStop Color="#00000000" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ── TextBox Style ── -->
        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Height"              Value="46"/>
            <Setter Property="FontSize"            Value="14"/>
            <Setter Property="FontFamily"          Value="Segoe UI"/>
            <Setter Property="Foreground"          Value="#000000"/>
            <Setter Property="Background"          Value="#F5F5F5"/>
            <Setter Property="BorderBrush"         Value="#CCCCCC"/>
            <Setter Property="BorderThickness"     Value="1.5"/>
            <Setter Property="Padding"             Value="14,0,14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"          Value="#8A0007"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#8A0007"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#8A0007"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── PasswordBox Style ── -->
        <Style x:Key="PasswordFieldStyle" TargetType="PasswordBox">
            <Setter Property="Height"              Value="46"/>
            <Setter Property="FontSize"            Value="14"/>
            <Setter Property="FontFamily"          Value="Segoe UI"/>
            <Setter Property="Foreground"          Value="#000000"/>
            <Setter Property="Background"          Value="#F5F5F5"/>
            <Setter Property="BorderBrush"         Value="#CCCCCC"/>
            <Setter Property="BorderThickness"     Value="1.5"/>
            <Setter Property="Padding"             Value="14,0,14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"          Value="#8A0007"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#8A0007"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#8A0007"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary Login Button Style ── -->
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height"          Value="48"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="Background"      Value="#8A0007"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#F7AA37"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#4E0205"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Role Tab Button Style (Active) ── -->
        <Style x:Key="RoleTabActiveStyle" TargetType="Button">
            <Setter Property="Height"          Value="38"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="Background"      Value="#8A0007"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Role Tab Button Style (Inactive) ── -->
        <Style x:Key="RoleTabInactiveStyle" TargetType="Button">
            <Setter Property="Height"          Value="38"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Normal"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Foreground"      Value="#555555"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#F0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── "Forgot Password" link button ── -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#8A0007"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="linkText"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   TextDecorations="Underline"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="linkText" Property="Foreground" Value="#F7AA37"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ══════════════════════════════════════════
         ROOT GRID — Two columns:
           Col 0 (40%): Left white login card panel
           Col 1 (60%): Right deep-red brand panel
    ══════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#FFFFFF">

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Logo area -->
                    <RowDefinition Height="Auto"/>
                    <!-- Spacer -->
                    <RowDefinition Height="*"/>
                    <!-- Login card -->
                    <RowDefinition Height="Auto"/>
                    <!-- Spacer -->
                    <RowDefinition Height="*"/>
                    <!-- Footer -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="40,30,0,30">

                    <Image Source="/resources/logo.png" Width="80" Height="80" />

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MEDI HELP J'Pura" FontSize="18" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#4E0205" />
                        <TextBlock Text="University Medical Centre" FontSize="10" Foreground="Gray" Margin="0,1,0,0" />
                    </StackPanel>

                </StackPanel>

                <!-- ── Login Form Card ── -->
                <StackPanel Grid.Row="2"
                            Margin="48,0,48,0"
                            VerticalAlignment="Center">

                    <!-- Greeting -->
                    <TextBlock Text="Welcome Back"
                               FontSize="28"
                               FontWeight="Bold"
                               FontFamily="Segoe UI"
                               Foreground="#4E0205"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Sign in to your account to continue"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               Foreground="#777777"
                               Margin="0,0,0,28"/>

                    <!-- ── Role Selector Tabs ── -->
                    <Border Background="#F5F5F5"
                            CornerRadius="8"
                            Padding="4"
                            Margin="0,0,0,28">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnRoleAdmin"
                                    Grid.Column="0"
                                    Content="Admin"
                                    Style="{StaticResource RoleTabActiveStyle}"
                                    Click="BtnRoleAdmin_Click"/>

                            <Button x:Name="BtnRoleDoctor"
                                    Grid.Column="1"
                                    Content="Doctor"
                                    Style="{StaticResource RoleTabInactiveStyle}"
                                    Click="BtnRoleDoctor_Click"
                                    Margin="4,0"/>

                            <Button x:Name="BtnRoleStaff"
                                    Grid.Column="2"
                                    Content="Staff"
                                    Style="{StaticResource RoleTabInactiveStyle}"
                                    Click="BtnRoleStaff_Click" Height="38" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <!-- ── Username Field ── -->
                    <TextBlock Text="Username"
                               FontSize="13"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               Foreground="#333333"
                               Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,18">
                        <TextBox x:Name="TxtUsername"
                                 Style="{StaticResource InputFieldStyle}"
                                 Padding="44,0,14,0"
                                 KeyDown="TxtUsername_KeyDown"/>
                        <!-- User icon -->
                        <TextBlock Text="👤"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0"
                                   IsHitTestVisible="False"/>
                        <!-- Placeholder -->
                        <TextBlock x:Name="TxtUsernamePlaceholder"
                                   Text="Enter your username"
                                   FontSize="13"
                                   FontFamily="Segoe UI"
                                   Foreground="#AAAAAA"
                                   VerticalAlignment="Center"
                                   Margin="46,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <!-- ── Password Field ── -->
                    <TextBlock Text="Password"
                               FontSize="13"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               Foreground="#333333"
                               Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,8">
                        <PasswordBox x:Name="TxtPassword"
                                     Style="{StaticResource PasswordFieldStyle}"
                                     Padding="44,0,14,0"
                                     PasswordChanged="TxtPassword_PasswordChanged"
                                     KeyDown="TxtPassword_KeyDown"/>
                        <!-- Lock icon -->
                        <TextBlock Text="🔒"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0"
                                   IsHitTestVisible="False"/>
                        <!-- Placeholder -->
                        <TextBlock x:Name="TxtPasswordPlaceholder"
                                   Text="Enter your password"
                                   FontSize="13"
                                   FontFamily="Segoe UI"
                                   Foreground="#AAAAAA"
                                   VerticalAlignment="Center"
                                   Margin="46,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <!-- ── Forgot Password ── -->
                    <DockPanel Margin="0,0,0,24">
                        <Button Content="Forgot Password?"
                                Style="{StaticResource LinkButtonStyle}"
                                DockPanel.Dock="Right"
                                Click="BtnForgotPassword_Click"/>
                    </DockPanel>

                    <!-- ── Error Message ── -->
                    <Border x:Name="ErrorBorder"
                            Background="#FFF0F0"
                            BorderBrush="#8A0007"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,0,0,14"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠  "
                                       FontSize="13"
                                       Foreground="#8A0007"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtErrorMessage"
                                       Text="Invalid username or password."
                                       FontSize="13"
                                       FontFamily="Segoe UI"
                                       Foreground="#8A0007"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Login Button ── -->
                    <Button x:Name="BtnLogin"
                            Content="Sign In"
                            Style="{StaticResource LoginButtonStyle}"
                            Click="BtnLogin_Click"/>

                    <!-- ── Current Role indicator ── -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0">
                        <TextBlock Text="Signing in as: "
                                   FontSize="12"
                                   FontFamily="Segoe UI"
                                   Foreground="#888888"/>
                        <TextBlock x:Name="TxtCurrentRole"
                                   Text="Admin"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   Foreground="#8A0007"/>
                    </StackPanel>

                </StackPanel>

                <!-- ── Footer ── -->
                <TextBlock Grid.Row="4"
                           Text="© 2025 University of Sri Jayewardenepura Medical Centre"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           Foreground="#AAAAAA"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════
             RIGHT PANEL — Brand / Illustration
        ═══════════════════════════════════════ -->
        <Border Grid.Column="1"
                Background="{StaticResource RightPanelGradient}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── Central Brand Content ── -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="48,0">

                    <!-- Large decorative cross -->
                    <Border Width="110" Height="110"
                            CornerRadius="55"
                            Background="#00000000"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="2"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,28">
                        <Image Source="/resources/logo.png"/>
                    </Border>


                    <TextBlock Text="M E D I   H E L P   J'PURA"
                               FontSize="32"
                               FontWeight="Bold"
                               FontFamily="Segoe UI"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="University Medical Centre System"
                               FontSize="15"
                               FontFamily="Segoe UI"
                               Foreground="#FFDDAA"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,36"/>

                    <!-- Divider -->
                    <Border Height="1"
                            Background="#44FFFFFF"
                            Margin="40,0,40,36"/>

                    <!-- Feature bullets -->
                    <StackPanel Margin="70,0">

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="32" Height="32"
                                    CornerRadius="16"
                                    Background="#33FFFFFF"
                                    Margin="0,0,14,0">
                                <TextBlock Text="🏥"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Patient Management"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           Foreground="#FFFFFF"/>
                                <TextBlock Text="Complete patient records &amp; history"
                                           FontSize="11"
                                           FontFamily="Segoe UI"
                                           Foreground="#FFCCAA"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="32" Height="32"
                                    CornerRadius="16"
                                    Background="#33FFFFFF"
                                    Margin="0,0,14,0">
                                <TextBlock Text="📅"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Appointment Scheduling"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           Foreground="#FFFFFF"/>
                                <TextBlock Text="Efficient doctor-patient scheduling"
                                           FontSize="11"
                                           FontFamily="Segoe UI"
                                           Foreground="#FFCCAA"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32"
                                    CornerRadius="16"
                                    Background="#33FFFFFF"
                                    Margin="0,0,14,0">
                                <TextBlock Text="📋"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Clinical Reports"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           Foreground="#FFFFFF"/>
                                <TextBlock Text="Real-time analytics &amp; reporting"
                                           FontSize="11"
                                           FontFamily="Segoe UI"
                                           Foreground="#FFCCAA"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>

                </StackPanel>

                <!-- ── Gold accent strip at bottom ── -->
                <Border Grid.Row="2"
                        VerticalAlignment="Bottom"
                        Height="5"
                        Background="#F7AA37"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
