<UserControl x:Class="Project_.Views.AdminShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Project_.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="#F9FAFB">

    <UserControl.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF5F5"/>
                                <Setter Property="Foreground" Value="#8A0007"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DropShadowEffect x:Key="DropShadow" BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.1"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo Area -->
                <Border Grid.Row="0" Padding="15,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#8A0007" Offset="0.0"/>
                            <GradientStop Color="#4E0205" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="White" CornerRadius="12" Padding="5" Margin="0,0,0,10" Effect="{DynamicResource DropShadow}" Width="74">
                            <Image Source="/view/logo.png" Height="63" RenderOptions.BitmapScalingMode="HighQuality" Margin="-3,0,-3,0"/>
                        </Border>
                        <TextBlock Text="MEDI HELP J'PURA" Foreground="White" FontWeight="Bold" FontSize="13" TextAlignment="Center"/>
                        <TextBlock Text="Admin Portal" Foreground="#FFC1C1" FontSize="11" TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- User Badge -->
                <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="15,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#8A0007" Margin="0,0,10,0">
                            <TextBlock Text="A" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Admin User" FontWeight="SemiBold" FontSize="13" Foreground="#1F2937"/>
                            <TextBlock Text="Admin" FontSize="11" Foreground="#9CA3AF"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,15,10,10">
                        <Button x:Name="BtnDashboard" Content="Dashboard" Style="{DynamicResource SidebarButtonStyle}" Tag="Dashboard" Click="NavButton_Click" Background="#8A0007" Foreground="White" FontWeight="SemiBold"/>
                        <Button x:Name="BtnUsers" Content="User Management" Style="{DynamicResource SidebarButtonStyle}" Tag="Users" Click="NavButton_Click"/>
                        
                        <TextBlock Text="MODULES" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="15,15,0,5"/>
                        <Button x:Name="BtnPatients" Content="Patient Management" Style="{DynamicResource SidebarButtonStyle}" Tag="Patients" Click="NavButton_Click"/>
                        <Button x:Name="BtnInventory" Content="Inventory Management" Style="{DynamicResource SidebarButtonStyle}" Tag="Inventory" Click="NavButton_Click"/>
                        
                        <TextBlock Text="SYSTEM" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="15,15,0,5"/>
                        <Button x:Name="BtnBackup" Content="Backup &amp; Restore" Style="{DynamicResource SidebarButtonStyle}" Tag="Backup" Click="NavButton_Click"/>
                        <Button x:Name="BtnReports" Content="Reports" Style="{DynamicResource SidebarButtonStyle}" Tag="Reports" Click="NavButton_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Logout -->
                <Border Grid.Row="3" BorderBrush="#F3F4F6" BorderThickness="0,1,0,0" Padding="10,15">
                    <Button x:Name="BtnLogout" Content="Log Out" Background="Transparent" Foreground="#6B7280" BorderThickness="0" HorizontalContentAlignment="Left" Padding="10" Click="BtnLogout_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="15,10">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                        <Setter Property="Foreground" Value="#8A0007"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="0"/>

    </Grid>
</UserControl>
