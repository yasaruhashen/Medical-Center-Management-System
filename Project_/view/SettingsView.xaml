<UserControl x:Class="Project_.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <ScrollViewer Padding="25" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="MainContainer" Opacity="0">
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>
            
            <Grid Margin="0,0,0,20">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="System Settings" FontWeight="Bold" FontSize="24" Foreground="#1F2937"/>
                    <TextBlock Text="Configure general system preferences and center information" FontSize="14" Foreground="#6B7280"/>
                </StackPanel>
            </Grid>

            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="25">
                <StackPanel>
                    <TextBlock Text="Center Details" FontWeight="SemiBold" FontSize="16" Foreground="#1F2937" Margin="0,0,0,15"/>
                    
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Center Name" VerticalAlignment="Center" Foreground="#4B5563"/>
                        <TextBox x:Name="TxtCenterName" Grid.Column="1" Text="University Medical Centre" Padding="10" BorderBrush="#D1D5DB" BorderThickness="1" Background="#F9FAFB"/>
                    </Grid>
                    
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Contact Email" VerticalAlignment="Center" Foreground="#4B5563"/>
                        <TextBox x:Name="TxtContactEmail" Grid.Column="1" Text="admin@medihelp.ac.lk" Padding="10" BorderBrush="#D1D5DB" BorderThickness="1" Background="#F9FAFB"/>
                    </Grid>
                    
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Contact Phone" VerticalAlignment="Center" Foreground="#4B5563"/>
                        <TextBox x:Name="TxtContactPhone" Grid.Column="1" Text="+94 11 288 1000" Padding="10" BorderBrush="#D1D5DB" BorderThickness="1" Background="#F9FAFB"/>
                    </Grid>
                    
                    <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,10,0,20"/>
                    
                    <TextBlock Text="Preferences" FontWeight="SemiBold" FontSize="16" Foreground="#1F2937" Margin="0,0,0,15"/>
                    
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Theme" VerticalAlignment="Center" Foreground="#4B5563"/>
                        <ComboBox x:Name="CmbTheme" Grid.Column="1" Padding="10" BorderBrush="#D1D5DB" BorderThickness="1" Background="#F9FAFB">
                            <ComboBoxItem Content="Light" IsSelected="True"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                    </Grid>
                    
                    <Button x:Name="BtnSaveSettings" Content="Save Settings" Background="#8A0007" Foreground="White" FontWeight="SemiBold"
                            Padding="15,10" BorderThickness="0" Click="BtnSaveSettings_Click" Cursor="Hand" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
