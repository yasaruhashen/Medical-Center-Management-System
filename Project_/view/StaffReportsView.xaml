<UserControl x:Class="Project_.Views.StaffReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <Grid>
        <ScrollViewer Padding="25" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MainContainer" Opacity="0">
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,0" To="0,0,0,0" Duration="0:0:0.5">
                                    <ThicknessAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                </ThicknessAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </StackPanel.Triggers>
                
                <!-- Header -->
                <StackPanel Margin="0,0,0,25">
                    <TextBlock Text="Staff Reports" FontWeight="Bold" FontSize="24" Foreground="#1F2937"/>
                    <TextBlock Text="View analytics and download reports for patients, inventory, appointments, and prescriptions." FontSize="14" Foreground="#6B7280"/>
                </StackPanel>

                <!-- Download Buttons -->
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Click="BtnDownloadPatients_Click" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" Padding="15" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                        <Button.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Button.Effect>
                        <StackPanel Orientation="Horizontal" Width="200">
                            <Border Width="36" Height="36" CornerRadius="8" Background="#FFF0F0" Margin="0,0,12,0">
                                <TextBlock Text="👥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8A0007"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Width="120">
                                <TextBlock Text="Patient Report" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                                <TextBlock Text="Download CSV" FontSize="12" Foreground="#9CA3AF"/>
                            </StackPanel>
                            <TextBlock Text="⬇" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Click="BtnDownloadAppointments_Click" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" Padding="15" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                        <Button.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Button.Effect>
                        <StackPanel Orientation="Horizontal" Width="200">
                            <Border Width="36" Height="36" CornerRadius="8" Background="#FFF0F0" Margin="0,0,12,0">
                                <TextBlock Text="📅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8A0007"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Width="120">
                                <TextBlock Text="Appointment" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                                <TextBlock Text="Download CSV" FontSize="12" Foreground="#9CA3AF"/>
                            </StackPanel>
                            <TextBlock Text="⬇" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" Click="BtnDownloadInventory_Click" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" Padding="15" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                        <Button.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Button.Effect>
                        <StackPanel Orientation="Horizontal" Width="200">
                            <Border Width="36" Height="36" CornerRadius="8" Background="#FFF0F0" Margin="0,0,12,0">
                                <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8A0007"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Width="120">
                                <TextBlock Text="Inventory Report" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                                <TextBlock Text="Download CSV" FontSize="12" Foreground="#9CA3AF"/>
                            </StackPanel>
                            <TextBlock Text="⬇" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="6" Click="BtnDownloadPrescriptions_Click" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" Padding="15" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                        <Button.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Button.Effect>
                        <StackPanel Orientation="Horizontal" Width="200">
                            <Border Width="36" Height="36" CornerRadius="8" Background="#FFF0F0" Margin="0,0,12,0">
                                <TextBlock Text="💊" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8A0007"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Width="120">
                                <TextBlock Text="Prescriptions" FontSize="14" FontWeight="SemiBold" Foreground="#374151"/>
                                <TextBlock Text="Download CSV" FontSize="12" Foreground="#9CA3AF"/>
                            </StackPanel>
                            <TextBlock Text="⬇" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Charts -->
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Patients by Gender -->
                    <Border Grid.Row="0" Grid.Column="0" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Patients by Gender" FontWeight="SemiBold" FontSize="16" Foreground="#374151" Margin="0,0,0,15"/>
                            <Grid Height="160">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="130" Height="130">
                                    <Ellipse Fill="#8A0007" Width="130" Height="130"/>
                                    <Path Data="M 65,65 L 130,65 A 65,65 0 0,1 65,130 Z" Fill="#F7AA37"/>
                                    <Ellipse Fill="White" Width="70" Height="70" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#8A0007" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Male" Foreground="#4B5563" FontSize="12" Width="60"/>
                                        <TextBlock Text="215" Foreground="#1F2937" FontWeight="Bold" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#F7AA37" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Female" Foreground="#4B5563" FontSize="12" Width="60"/>
                                        <TextBlock Text="135" Foreground="#1F2937" FontWeight="Bold" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Prescriptions by Status -->
                    <Border Grid.Row="0" Grid.Column="2" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Prescriptions by Status" FontWeight="SemiBold" FontSize="16" Foreground="#374151" Margin="0,0,0,15"/>
                            <Grid Height="160">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="130" Height="130">
                                    <Ellipse Fill="#8A0007" Width="130" Height="130"/>
                                    <Path Data="M 65,65 L 130,65 A 65,65 0 0,1 65,130 Z" Fill="#F7AA37"/>
                                    <Ellipse Fill="White" Width="70" Height="70" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#8A0007" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Pending" Foreground="#4B5563" FontSize="12" Width="60"/>
                                        <TextBlock Text="45" Foreground="#1F2937" FontWeight="Bold" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="#F7AA37" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Processed" Foreground="#4B5563" FontSize="12" Width="60"/>
                                        <TextBlock Text="120" Foreground="#1F2937" FontWeight="Bold" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Appointments by Status -->
                    <Border Grid.Row="2" Grid.Column="0" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Appointments by Status" FontWeight="SemiBold" FontSize="16" Foreground="#374151" Margin="0,0,0,15"/>
                            <Grid Height="160">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,0,0">
                                    <Border Background="#8A0007" Height="120" CornerRadius="4,4,0,0" Margin="10,0"/>
                                    <TextBlock Text="Scheduled" TextAlignment="Center" FontSize="11" Foreground="#6B7280" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                    <Border Background="#F7AA37" Height="140" CornerRadius="4,4,0,0" Margin="10,0"/>
                                    <TextBlock Text="Completed" TextAlignment="Center" FontSize="11" Foreground="#6B7280" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <Border Background="#4E0205" Height="40" CornerRadius="4,4,0,0" Margin="10,0"/>
                                    <TextBlock Text="Cancelled" TextAlignment="Center" FontSize="11" Foreground="#6B7280" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Inventory by Category -->
                    <Border Grid.Row="2" Grid.Column="2" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Inventory by Category" FontWeight="SemiBold" FontSize="16" Foreground="#374151" Margin="0,0,0,15"/>
                            <Grid Height="160">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,0,0">
                                    <Border Background="#8A0007" Height="140" CornerRadius="4,4,0,0" Margin="10,0"/>
                                    <TextBlock Text="Pills" TextAlignment="Center" FontSize="11" Foreground="#6B7280" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                    <Border Background="#8A0007" Height="80" CornerRadius="4,4,0,0" Margin="10,0"/>
                                    <TextBlock Text="Capsules" TextAlignment="Center" FontSize="11" Foreground="#6B7280" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <Border Background="#8A0007" Height="40" CornerRadius="4,4,0,0" Margin="10,0"/>
                                    <TextBlock Text="Syrups" TextAlignment="Center" FontSize="11" Foreground="#6B7280" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                    <Border Background="#8A0007" Height="100" CornerRadius="4,4,0,0" Margin="10,0"/>
                                    <TextBlock Text="Equipment" TextAlignment="Center" FontSize="11" Foreground="#6B7280" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Low Stock Alert Table -->
                <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Table Header -->
                        <Border Background="#4E0205" CornerRadius="12,12,0,0" Padding="20,15">
                            <TextBlock Text="Low Stock Alert" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                        </Border>
                        
                        <Border Background="#F9FAFB" Padding="20,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Item" Foreground="#6B7280" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="Category" Foreground="#6B7280" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="Current Qty" Foreground="#6B7280" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="Min Stock" Foreground="#6B7280" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="Status" Foreground="#6B7280" FontSize="12"/>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="LowStockList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="0,1,0,0" Padding="20,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#1F2937" FontSize="13"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#4B5563" FontSize="13"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Quantity}" Foreground="#8A0007" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Grid.Column="3" Text="{Binding MinStock}" Foreground="#4B5563" FontSize="13"/>
                                            <Border Grid.Column="4" Background="{Binding StatusBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
