<UserControl x:Class="Project_.Views.AppointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <Grid>
        <ScrollViewer Padding="25" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MainContainer" Opacity="0">
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,0" To="0,0,0,0" Duration="0:0:0.5">
                                    <ThicknessAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                </ThicknessAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </StackPanel.Triggers>
                
                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Appointment Management" FontWeight="Bold" FontSize="24" Foreground="#1F2937"/>
                        <TextBlock Text="Schedule and manage patient appointments" FontSize="14" Foreground="#6B7280"/>
                    </StackPanel>
                    <Button x:Name="BtnAddAppointment" Grid.Column="1" Background="#8A0007" Foreground="White" FontWeight="SemiBold"
                            Padding="15,10" BorderThickness="0" Click="BtnBook_Click" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" Margin="0,0,5,0" FontWeight="Bold"/>
                                <TextBlock Text="New Appointment"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>

                <TextBlock x:Name="TxtMsg" Foreground="#166534" Background="#F0FDF4" Padding="15,10" Margin="0,0,0,15" Visibility="Collapsed">
                    <TextBlock.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="BorderBrush" Value="#BBF7D0"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Style>
                    </TextBlock.Resources>
                </TextBlock>

                <!-- Search and Filter -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtSearch" Text="Search by patient, doctor, or date..." Foreground="#9CA3AF" BorderThickness="0" Background="Transparent" Width="400" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="5,0">
                        <ComboBox x:Name="CmbFilterStatus" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" VerticalContentAlignment="Center" Height="38" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="Scheduled"/>
                            <ComboBoxItem Content="Completed"/>
                            <ComboBoxItem Content="Cancelled"/>
                            <ComboBoxItem Content="CheckedIn"/>
                        </ComboBox>
                    </Border>
                </Grid>

                <!-- Table -->
                <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Table Header -->
                        <Border Background="#4E0205" CornerRadius="12,12,0,0" Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Patient" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="Doctor" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="Date" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="Time" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="Reason" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="5" Text="Status" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="6" Text="Actions" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="AppointmentsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="15,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F9FAFB"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0" Text="{Binding PatientName}" Foreground="#1F2937" FontWeight="Medium" VerticalAlignment="Center" FontSize="13"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DoctorName}" Foreground="#4B5563" VerticalAlignment="Center" FontSize="13"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Date}" Foreground="#4B5563" VerticalAlignment="Center" FontSize="13"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Time}" Foreground="#4B5563" VerticalAlignment="Center" FontSize="13"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Reason}" Foreground="#6B7280" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            
                                            <!-- Status ComboBox -->
                                            <ComboBox Grid.Column="5" Text="{Binding Status}" Tag="{Binding Id}" SelectionChanged="Status_SelectionChanged" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Foreground="{Binding StatusColor}" FontWeight="Bold" Padding="5,2" Width="110" HorizontalAlignment="Left">
                                                <ComboBoxItem Content="Scheduled"/>
                                                <ComboBoxItem Content="Completed"/>
                                                <ComboBoxItem Content="Cancelled"/>
                                                <ComboBoxItem Content="CheckedIn"/>
                                                <ComboBox.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="10"/>
                                                        <Setter Property="Background" Value="{Binding StatusBg}"/>
                                                    </Style>
                                                </ComboBox.Resources>
                                            </ComboBox>
                                            
                                            <!-- Actions -->
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="✏️" Tag="{Binding Id}" Click="BtnEditAppt_Click" Background="Transparent" BorderThickness="0" Margin="0,0,5,0" Cursor="Hand" Foreground="#2563EB"/>
                                                <Button Content="🗑️" Tag="{Binding Id}" Click="BtnDeleteAppt_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#8A0007"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Book overlay -->
        <Border x:Name="Overlay" Background="#88000000" Visibility="Collapsed" Panel.ZIndex="10">
            <Border Background="White" CornerRadius="16" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="20,15">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8A0007" Offset="0"/>
                                <GradientStop Color="#4E0205" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <TextBlock Text="Schedule Appointment" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Foreground="#FECACA" BorderThickness="0" FontSize="14" Click="BtnCancelBook_Click" Cursor="Hand"/>
                        </Grid>
                    </Border>
                    
                    <StackPanel Grid.Row="1" Margin="25">
                        <TextBlock Text="Patient *" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                        <ComboBox x:Name="FPatient" Height="36" Margin="0,0,0,15" DisplayMemberPath="FullName">
                            <ComboBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></ComboBox.Resources>
                        </ComboBox>

                        <TextBlock Text="Doctor *" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                        <ComboBox x:Name="FDoctor" Height="36" Margin="0,0,0,15" DisplayMemberPath="FullName">
                            <ComboBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></ComboBox.Resources>
                        </ComboBox>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Date *" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                                <DatePicker x:Name="FDate" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Time *" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                                <ComboBox x:Name="FTime" Height="36">
                                    <ComboBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></ComboBox.Resources>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Reason" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                        <TextBox x:Name="FNotes" Padding="8,6" Margin="0,0,0,15" BorderBrush="#E5E7EB" BorderThickness="1">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                        </TextBox>

                        <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="13" Visibility="Collapsed" Margin="0,0,0,10"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" Content="Cancel" Padding="0,10" Background="White" Foreground="#4B5563" BorderBrush="#E5E7EB" BorderThickness="1" Click="BtnCancelBook_Click" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            
                            <Button Grid.Column="2" Padding="0,10" Background="#8A0007" Foreground="White" BorderThickness="0" Click="BtnSaveBook_Click" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓" Margin="0,0,5,0" FontWeight="Bold"/>
                                        <TextBlock Text="Schedule" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
