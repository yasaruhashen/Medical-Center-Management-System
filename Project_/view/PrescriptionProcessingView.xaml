<UserControl x:Class="Project_.Views.PrescriptionProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <Grid>
        <ScrollViewer Padding="25" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MainContainer" Opacity="0">
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,0" To="0,0,0,0" Duration="0:0:0.5">
                                    <ThicknessAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                </ThicknessAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </StackPanel.Triggers>
                
                <!-- Header -->
                <StackPanel Margin="0,0,0,25">
                    <TextBlock Text="Prescription Processing" FontWeight="Bold" FontSize="24" Foreground="#1F2937"/>
                    <TextBlock Text="View and process doctor prescriptions — inventory is automatically deducted upon processing." FontSize="14" Foreground="#6B7280"/>
                </StackPanel>

                <!-- Summary Stats -->
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="15">
                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtTotal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#8A0007" HorizontalAlignment="Center"/>
                            <TextBlock Text="Total Prescriptions" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="15">
                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtPending" Text="0" FontSize="26" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center"/>
                            <TextBlock Text="Pending Prescriptions" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="15">
                        <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtProcessed" Text="0" FontSize="26" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center"/>
                            <TextBlock Text="Processed Prescriptions" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="TxtMsg" Foreground="#166534" Background="#F0FDF4" Padding="15,10" Margin="0,0,0,15" Visibility="Collapsed">
                    <TextBlock.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="BorderBrush" Value="#BBF7D0"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Style>
                    </TextBlock.Resources>
                </TextBlock>

                <!-- Search and Filter -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtSearch" Text="Search by patient or doctor..." Foreground="#9CA3AF" BorderThickness="0" Background="Transparent" Width="400" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="5,0">
                        <ComboBox x:Name="CmbFilter" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" VerticalContentAlignment="Center" Height="38" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="Pending"/>
                            <ComboBoxItem Content="Processed"/>
                        </ComboBox>
                    </Border>
                </Grid>

                <!-- Prescriptions List -->
                <ItemsControl x:Name="PrescriptionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="{Binding BorderColor}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,15">
                                <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                                <StackPanel>
                                    <!-- Card Header -->
                                    <Border Background="{Binding HeaderBg}" BorderBrush="{Binding BorderColor}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="20,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Patient & Doctor Info -->
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="👤" Foreground="#8A0007" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="16"/>
                                                    <TextBlock Text="{Binding PatientName}" FontWeight="Bold" FontSize="16" Foreground="#1F2937" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="26,0,0,0">
                                                    <TextBlock Text="👤 " Foreground="#6B7280" FontSize="12"/>
                                                    <TextBlock Text="{Binding DoctorName}" Foreground="#6B7280" FontSize="12" Margin="0,0,15,0"/>
                                                    <TextBlock Text="📅 " Foreground="#6B7280" FontSize="12"/>
                                                    <TextBlock Text="{Binding Date}" Foreground="#6B7280" FontSize="12" Margin="0,0,15,0"/>
                                                    <Border Background="#FFF0F0" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,0,0">
                                                        <TextBlock Text="{Binding Diagnosis}" Foreground="#8A0007" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            
                                            <!-- Status & Action -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{Binding StatusBg}" CornerRadius="20" Padding="12,6" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="●" Foreground="{Binding StatusColor}" Margin="0,0,6,0" FontSize="10" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                
                                                <Button Content="📦 Process" Tag="{Binding Id}" Click="BtnProcess_Click" Background="#8A0007" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Padding="15,8" Visibility="{Binding ShowProcessButton}" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="8"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Items -->
                                    <Border Padding="20">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#F9FAFB" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                                    <TextBlock Text="💊" Foreground="#8A0007" Margin="0,2,10,0" FontSize="16"/>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding MedicationName}" FontWeight="SemiBold" FontSize="14" Foreground="#1F2937"/>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                            <TextBlock Text="{Binding Dosage}" Foreground="#6B7280" FontSize="12"/>
                                                                            <TextBlock Text=" — " Foreground="#6B7280" FontSize="12"/>
                                                                            <TextBlock Text="{Binding Instructions}" Foreground="#6B7280" FontSize="12"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                
                                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Quantity, StringFormat='Qty: {0}'}" FontWeight="SemiBold" FontSize="14" Foreground="#1F2937" HorizontalAlignment="Right"/>
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                                        <TextBlock Text="Stock: " Foreground="{Binding StockColor}" FontSize="12"/>
                                                                        <TextBlock Text="{Binding Stock}" Foreground="{Binding StockColor}" FontSize="12"/>
                                                                        <TextBlock Text=" " Foreground="{Binding StockColor}" FontSize="12"/>
                                                                        <TextBlock Text="{Binding Unit}" Foreground="{Binding StockColor}" FontSize="12"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            
                                            <TextBlock Text="{Binding Notes, StringFormat='📝 {0}'}" Foreground="#6B7280" FontSize="12" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
