<UserControl x:Class="Project_.Views.PatientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <ScrollViewer Padding="25" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="MainContainer" Opacity="0">
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,0" To="0,0,0,0" Duration="0:0:0.5">
                                <ThicknessAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                            </ThicknessAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>
            
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Patient Management" FontWeight="Bold" FontSize="24" Foreground="#1F2937"/>
                    <TextBlock Text="Manage patient records, demographics, and registration details" FontSize="14" Foreground="#6B7280"/>
                </StackPanel>
                <Button x:Name="BtnAddPatient" Grid.Column="1" Content="+ Add Patient" Background="#8A0007" Foreground="White" FontWeight="SemiBold"
                        Padding="15,10" BorderThickness="0" Click="BtnAddPatient_Click" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
            </Grid>

            <!-- Search and Filter -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtSearch" Text="Search patients..." Foreground="#9CA3AF" BorderThickness="0" Background="Transparent" 
                             VerticalAlignment="Center" Width="300" FontSize="14"
                             GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" TextChanged="SearchBox_TextChanged"/>
                </StackPanel>
            </Border>

            <!-- Patients Table -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12">
                <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                <StackPanel>
                    <!-- Table Header -->
                    <Border Background="#F9FAFB" CornerRadius="12,12,0,0" Padding="20,15" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PATIENT" FontWeight="SemiBold" Foreground="#6B7280" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="ID / TYPE" FontWeight="SemiBold" Foreground="#6B7280" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="GENDER" FontWeight="SemiBold" Foreground="#6B7280" FontSize="12"/>
                            <TextBlock Grid.Column="3" Text="CONTACT" FontWeight="SemiBold" Foreground="#6B7280" FontSize="12"/>
                            <TextBlock Grid.Column="4" Text="ACTIONS" FontWeight="SemiBold" Foreground="#6B7280" FontSize="12"/>
                        </Grid>
                    </Border>
                    <!-- Dynamic List -->
                    <ItemsControl x:Name="PatientsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="20,15" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Background="White">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="36" Height="36" CornerRadius="8" Background="#FFF0F0" Margin="0,0,12,0">
                                                <TextBlock Text="🏥" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" Foreground="#1F2937" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Email}" Foreground="#6B7280" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RegistrationNumber}" Foreground="#4B5563" FontWeight="Medium"/>
                                            <Border Background="#F3F4F6" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding PatientType}" Foreground="#374151" FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Column="2" Text="{Binding Gender}" Foreground="#4B5563" VerticalAlignment="Center"/>
                                        
                                        <TextBlock Grid.Column="3" Text="{Binding PhoneNumber}" Foreground="#4B5563" VerticalAlignment="Center"/>
                                        
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="✏️" Tag="{Binding Id}" Click="BtnEditPatient_Click" Background="Transparent" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Edit Patient"/>
                                            <Button Content="🗑️" Tag="{Binding Id}" Click="BtnDeletePatient_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Delete Patient"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
