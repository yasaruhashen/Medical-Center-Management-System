<UserControl x:Class="Project_.Views.PatientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <Grid>
        <ScrollViewer Padding="25" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MainContainer" Opacity="0">
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,0" To="0,0,0,0" Duration="0:0:0.5">
                                    <ThicknessAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                </ThicknessAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </StackPanel.Triggers>
                
                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Patient Registration" FontWeight="Bold" FontSize="24" Foreground="#1F2937"/>
                        <TextBlock Text="Register new patients and manage existing records" FontSize="14" Foreground="#6B7280"/>
                    </StackPanel>
                    <Button x:Name="BtnAdd" Grid.Column="1" Content="+ Register Patient" Background="#8A0007" Foreground="White" FontWeight="SemiBold"
                            Padding="15,10" BorderThickness="0" Click="BtnAdd_Click" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- Search -->
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtSearch" Text="Search by name, student ID, or phone..." Foreground="#9CA3AF" BorderThickness="0" Background="Transparent" Width="400" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus"/>
                    </StackPanel>
                </Border>

                <!-- Table -->
                <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Table Header -->
                        <Border Background="#4E0205" CornerRadius="12,12,0,0" Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Patient" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="Student ID" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="Gender" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="Blood Group" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="Phone" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="5" Text="Registered" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="6" Text="Actions" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="PatientsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="15,10" Cursor="Hand" MouseLeftButtonUp="ViewPatient_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Patient -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="28" Height="28" CornerRadius="14" Background="#8A0007" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                                </Border>
                                                <TextBlock Text="{Binding FullName}" Foreground="#1F2937" FontWeight="Medium" VerticalAlignment="Center" FontSize="13"/>
                                            </StackPanel>
                                            
                                            <!-- Student ID -->
                                            <TextBlock Grid.Column="1" Text="{Binding StudentId}" Foreground="#4B5563" VerticalAlignment="Center" FontSize="13"/>
                                            
                                            <!-- Gender -->
                                            <TextBlock Grid.Column="2" Text="{Binding Gender}" Foreground="#4B5563" VerticalAlignment="Center" FontSize="13"/>
                                            
                                            <!-- Blood Group -->
                                            <Border Grid.Column="3" Background="{Binding BloodGroupBg}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BloodGroup}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                            
                                            <!-- Phone -->
                                            <TextBlock Grid.Column="4" Text="{Binding Phone}" Foreground="#4B5563" VerticalAlignment="Center" FontSize="13"/>
                                            
                                            <!-- Registered -->
                                            <TextBlock Grid.Column="5" Text="{Binding RegisteredDate}" Foreground="#6B7280" VerticalAlignment="Center" FontSize="12"/>
                                            
                                            <!-- Actions -->
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="✏️" Tag="{Binding Id}" Click="BtnEditPatient_Click" Background="Transparent" BorderThickness="0" Margin="0,0,5,0" Cursor="Hand"/>
                                                <Button Content="🗑️" Tag="{Binding Id}" Click="BtnDeletePatient_Click" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Editor Overlay -->
        <Border x:Name="EditorOverlay" Background="#88000000" Visibility="Collapsed" Panel.ZIndex="10">
            <Border Background="White" CornerRadius="16" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="20,15">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8A0007" Offset="0"/>
                                <GradientStop Color="#4E0205" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <TextBlock x:Name="TxtEditorTitle" Text="Register New Patient" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Foreground="#FECACA" BorderThickness="0" FontSize="14" Click="BtnCancel_Click" Cursor="Hand"/>
                        </Grid>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="600" Padding="25">
                        <StackPanel>
                            <!-- Fields layout mimicking the React grid layout -->
                            <TextBlock Text="First Name *" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                            <TextBox x:Name="FFirst" Padding="8,6" Margin="0,0,0,15" BorderBrush="#E5E7EB" BorderThickness="1">
                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                            </TextBox>

                            <TextBlock Text="Last Name *" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                            <TextBox x:Name="FLast" Padding="8,6" Margin="0,0,0,15" BorderBrush="#E5E7EB" BorderThickness="1">
                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                            </TextBox>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Date of Birth *" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                                    <DatePicker x:Name="FDob" Height="32"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Gender *" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                                    <ComboBox x:Name="FGender" Height="32" BorderBrush="#E5E7EB" BorderThickness="1">
                                        <ComboBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></ComboBox.Resources>
                                        <ComboBoxItem Content="Male"/>
                                        <ComboBoxItem Content="Female"/>
                                        <ComboBoxItem Content="Other"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Phone *" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                                    <TextBox x:Name="FPhone" Padding="8,6" BorderBrush="#E5E7EB" BorderThickness="1">
                                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Student ID" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                                    <TextBox x:Name="FReg" Padding="8,6" BorderBrush="#E5E7EB" BorderThickness="1">
                                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                                    </TextBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Address" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                            <TextBox x:Name="FAddress" Padding="8,6" Margin="0,0,0,15" BorderBrush="#E5E7EB" BorderThickness="1">
                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                            </TextBox>

                            <TextBlock Text="Email" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                            <TextBox x:Name="FEmail" Padding="8,6" Margin="0,0,0,15" BorderBrush="#E5E7EB" BorderThickness="1">
                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                            </TextBox>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Patient Type" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                                    <ComboBox x:Name="FType" Height="32" SelectionChanged="FType_SelectionChanged" BorderBrush="#E5E7EB" BorderThickness="1">
                                        <ComboBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></ComboBox.Resources>
                                        <ComboBoxItem Content="External"/>
                                        <ComboBoxItem Content="Internal"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="PanelFaculty" Visibility="Collapsed" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Faculty" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                                        <TextBox x:Name="FFaculty" Padding="8,6" BorderBrush="#E5E7EB" BorderThickness="1">
                                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" x:Name="PanelYear">
                                        <TextBlock Text="Year of Study" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5" FontSize="13"/>
                                        <TextBox x:Name="FYear" Padding="8,6" BorderBrush="#E5E7EB" BorderThickness="1">
                                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="13" Margin="0,0,0,15" Visibility="Collapsed"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Button x:Name="BtnCancel" Grid.Column="0" Content="Cancel" Padding="0,10" Background="White" Foreground="#4B5563" BorderBrush="#E5E7EB" BorderThickness="1" Click="BtnCancel_Click" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                </Button>
                                
                                <Button Grid.Column="2" Padding="0,10" Background="#8A0007" Foreground="White" BorderThickness="0" Click="BtnSave_Click" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✓" Margin="0,0,5,0" FontWeight="Bold"/>
                                            <TextBlock Text="Register" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
