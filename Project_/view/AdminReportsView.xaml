<UserControl x:Class="Project_.Views.AdminReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9FAFB">
    <ScrollViewer Padding="25" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="System Reports" FontWeight="Bold" FontSize="24" Foreground="#1F2937" Margin="0,0,0,5"/>
            <TextBlock Text="Comprehensive analytics and downloadable reports for all system data." FontSize="14" Foreground="#6B7280" Margin="0,0,0,25"/>

            <!-- Quick Download Buttons -->
            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Staff Report -->
                <Border Grid.Column="0" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="15">
                    <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="8" Background="#FFF0F0" Margin="0,0,10,0">
                            <TextBlock Text="👥" Foreground="#8A0007" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Staff Report" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBlock Text="Download CSV" FontSize="11" Foreground="#9CA3AF"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Patient Report -->
                <Border Grid.Column="2" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="15">
                    <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="8" Background="#FDF0F0" Margin="0,0,10,0">
                            <TextBlock Text="👥" Foreground="#4E0205" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Patient Report" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBlock Text="Download CSV" FontSize="11" Foreground="#9CA3AF"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Inventory Report -->
                <Border Grid.Column="4" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="15">
                    <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="8" Background="#FFFBEB" Margin="0,0,10,0">
                            <TextBlock Text="📦" Foreground="#B45309" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Inventory Report" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBlock Text="Download CSV" FontSize="11" Foreground="#9CA3AF"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Appointment Report -->
                <Border Grid.Column="6" Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12" Padding="15">
                    <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="8" Background="#F0FDF4" Margin="0,0,10,0">
                            <TextBlock Text="📅" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Appointment Rep." FontWeight="SemiBold" Foreground="#374151" FontSize="11"/>
                            <TextBlock Text="Download CSV" FontSize="11" Foreground="#9CA3AF"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Low Stock Table -->
            <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="1" CornerRadius="12">
                <Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Color="#000000" Opacity="0.05"/></Border.Effect>
                <StackPanel>
                    <Border Background="#4E0205" CornerRadius="12,12,0,0" Padding="20,15">
                        <Grid>
                            <TextBlock Text="Low Stock Items Report" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                            <TextBlock Text="3 items need restocking" Foreground="#FECACA" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Background="#F9FAFB" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Item" Foreground="#6B7280" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Category" Foreground="#6B7280" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Current Qty" Foreground="#6B7280" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Min Stock" Foreground="#6B7280" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Status" Foreground="#6B7280" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                    <!-- Rows -->
                    <Border Background="White" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Paracetamol 500mg" Foreground="#1F2937"/>
                            <TextBlock Grid.Column="1" Text="Painkillers" Foreground="#4B5563"/>
                            <TextBlock Grid.Column="2" Text="50 units" Foreground="#8A0007" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="100 units" Foreground="#6B7280"/>
                            <Border Grid.Column="4" Background="#FFFBEB" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                <TextBlock Text="Low Stock" Foreground="#92400E" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Background="#F9FAFB" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Amoxicillin" Foreground="#1F2937"/>
                            <TextBlock Grid.Column="1" Text="Antibiotics" Foreground="#4B5563"/>
                            <TextBlock Grid.Column="2" Text="0 units" Foreground="#8A0007" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="50 units" Foreground="#6B7280"/>
                            <Border Grid.Column="4" Background="#FEF2F2" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                <TextBlock Text="Out of Stock" Foreground="#991B1B" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
