<Window x:Class="Project_.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Project_.Views"
        mc:Ignorable="d"
        Title="Medi Help J'Pura"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#FFFFFF">

    
    <Grid x:Name="RootGrid">

        <views:LoginView x:Name="LoginScreen"
                         Visibility="Visible" Loaded="LoginScreen_Loaded_1"/>

        
        <Grid x:Name="ShellGrid"
              Visibility="Collapsed">
            <TextBlock Text="Main Shell — navigate to DashboardView here"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="20"/>
        </Grid>

    </Grid>
</Window>
